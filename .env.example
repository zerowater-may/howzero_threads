# Threads API 설정
THREADS_APP_ID=your_app_id
THREADS_APP_SECRET=your_app_secret
THREADS_ACCESS_TOKEN=your_access_token
THREADS_USER_ID=your_user_id

# 이메일 설정
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_TO=recipient@example.com

# Zernio publish automation
ZERNIO_API_KEY=your_zernio_api_key

# TossInvest Open API
TOSSINVEST_CLIENT_ID=your_tossinvest_client_id
TOSSINVEST_CLIENT_SECRET=your_tossinvest_client_secret
# TOSSINVEST_BASE_URL=https://openapi.tossinvest.com

# Caption provider: anthropic | kimi | kimi_code | deepseek
CONTENT_CAPTIONS_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key
# CONTENT_CAPTIONS_PROVIDER=kimi
# MOONSHOT_API_KEY=your_moonshot_api_key
# KIMI_MODEL=kimi-k2.6
# Kimi Code membership key from https://www.kimi.com/code/console
# CONTENT_CAPTIONS_PROVIDER=kimi_code
# KIMI_API_KEY=your_kimi_code_api_key
# CONTENT_CAPTIONS_BASE_URL=https://api.kimi.com/coding/
# KIMI_CODE_MODEL=kimi-for-coding
# CONTENT_CAPTIONS_PROVIDER=deepseek
# DEEPSEEK_API_KEY=your_deepseek_api_key
# DEEPSEEK_MODEL=deepseek-v4-flash

# HowZero / HOWAAA server access
# 실제 비밀번호/키는 .env.local 또는 서버의 /etc/howzero/howzero.env에만 둔다.
HOWZERO_SSH_ALIAS=howzero
HOWZERO_SSH_HOST=151.245.106.229
HOWZERO_SSH_USER=root
HOWZERO_SSH_PASSWORD=your_local_password_only
HOWZERO_SSH_COMMAND="ssh howzero"

HOWZERO_SERVER_REPO_DIR=/opt/howzero
HOWZERO_SERVER_ENV_FILE=/etc/howzero/howzero.env
HOWZERO_WEB_SERVICE=howzero-web.service
HOWZERO_WORKER_SERVICE=howzero-worker.service
HOWZERO_WEB_PORT=3101

HOWAAA_DASHBOARD_REPO_DIR=/opt/howzero-dashboard
HOWAAA_DASHBOARD_SERVICE=howzero-dashboard.service
HOWAAA_DASHBOARD_PORT=3100
HOWAAA_TRENDS_PATH=/CMPA/howaaa-trends
HOWAAA_LANDING_PATH=/howaaa

HOWZERO_WEB_REMOTE_URL=http://151.245.106.229:3101
HOWAAA_DASHBOARD_REMOTE_URL=http://151.245.106.229:3100
HOWAAA_TRENDS_LOCAL_DEV_URL=http://127.0.0.1:3100/CMPA/howaaa-trends
HOWAAA_TRENDS_TUNNEL_URL=http://127.0.0.1:13101/CMPA/howaaa-trends
HOWAAA_LANDING_LOCAL_DEV_URL=http://127.0.0.1:3100/howaaa

HOWZERO_TEMP_PUBLIC_LOGIN_ID=admin
HOWZERO_TEMP_PUBLIC_LOGIN_PASSWORD=your_local_login_password_only
