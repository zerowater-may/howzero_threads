# ============================================================================
# 용감한 용팀장 — 6주 오프라인 AI 셀링 실전반 (1기) 랜딩 v2
# Vercel Project Settings → Environment Variables 에 동일 키로 등록.
# 비어 있어도 페이지는 깨지지 않고 "운영 입력 필요" 상태가 자연 노출됨.
# ============================================================================

# 신청서 구글폼 URL — 비면 신청 섹션 안내 + CTA #으로 폴백
NEXT_PUBLIC_GOOGLE_FORM_URL=https://forms.gle/XXXX

# 6/10 유튜브 무료강의 URL — 비면 CTA #으로 폴백
NEXT_PUBLIC_YOUTUBE_FREE_URL=https://youtube.com/XXXX

# 운영자 컨택 이메일 (footer mailto 링크)
NEXT_PUBLIC_CONTACT_EMAIL=braveyong@example.com

# 도메인 (og·sitemap·robots 절대 URL 생성용)
NEXT_PUBLIC_SITE_URL=https://braveyong.example.com

# GA4 (선택)
NEXT_PUBLIC_GA4_ID=

# 결제선생 / Paymint — 운영 비밀값은 .env.local 또는 Vercel Environment Variables에만 입력
NEXT_PUBLIC_BASE_URL=http://localhost:3200
PAYMINT_API_URL=https://erp-api.payssam.kr/
PAYMINT_API_KEY=
PAYMINT_MEMBER_ID=
PAYMINT_MERCHANT_ID=
PAYMINT_DRY_RUN=true
PAYMINT_BILL_EXPIRE_DAYS=3

# 8.15 통관대응 라이브 특강 (/815)
NEXT_PUBLIC_TONGGWAN_OPENCHAT_URL=   # 결제 완료자에게만 노출되는 카톡 오픈채팅방 링크
NEXT_PUBLIC_TONGGWAN_PAY_DEADLINE=2026-06-20T23:59:59+09:00

# 결제완료 자동 입장문자 (NCP SENS — bulsaja 계정 공유, 실값은 .env.local/Vercel env)
NCP_SENS_ACCESS=
NCP_SENS_SECRET=
NCP_SENS_ID=
NCP_SENS_NUMBER=
