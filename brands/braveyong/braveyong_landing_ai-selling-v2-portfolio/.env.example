# ============================================================================
# 용감한 용팀장 — 4주 오프라인 AI 셀링 실전반 랜딩 v2 (gigclass.kr)
# Vercel Project Settings → Environment Variables 에 동일 키로 등록.
# 비어 있어도 페이지는 깨지지 않고 "운영 입력 필요" 상태가 자연 노출됨.
# ============================================================================

# 유튜브 무료강의 URL — 비면 CTA #으로 폴백
NEXT_PUBLIC_YOUTUBE_FREE_URL=https://youtube.com/XXXX

# 운영자 컨택 이메일 (footer mailto 링크) — 비면 푸터에서 아예 감춤
NEXT_PUBLIC_CONTACT_EMAIL=

# 도메인 (og·sitemap·robots 절대 URL 생성용)
NEXT_PUBLIC_SITE_URL=https://www.gigclass.kr

# 현재 기수 결제 마감 (개강 전날 자정, KST). 코드 상수명은 config.payDeadline이지만
# env 키는 히스토리상 COHORT1 그대로다 — 키를 바꾸면 Vercel env를 못 읽고 폴백된다.
# 기수 전환 시 Vercel production env의 값도 반드시 같이 갱신할 것.
NEXT_PUBLIC_COHORT1_DEADLINE=2026-08-21T23:59:59+09:00

# 결제 전 문의 카카오 링크 (미설정 시 lib/config.ts 기본값 사용)
NEXT_PUBLIC_KAKAO_OPENCHAT_URL=
NEXT_PUBLIC_KAKAO_1TO1_URL=

# GA4 (선택)
NEXT_PUBLIC_GA4_ID=

# 결제선생 / Paymint — 운영 비밀값은 .env.local 또는 Vercel Environment Variables에만 입력
NEXT_PUBLIC_BASE_URL=http://localhost:3200
PAYMINT_API_URL=https://erp-api.payssam.kr/
PAYMINT_API_KEY=
PAYMINT_MEMBER_ID=
PAYMINT_MERCHANT_ID=
PAYMINT_DRY_RUN=true
PAYMINT_BILL_EXPIRE_DAYS=3

# 8.15 통관대응 라이브 특강 (/815)
NEXT_PUBLIC_TONGGWAN_OPENCHAT_URL=   # 결제 완료자에게만 노출되는 카톡 오픈채팅방 링크
NEXT_PUBLIC_TONGGWAN_PAY_DEADLINE=2026-06-20T23:59:59+09:00

# 결제완료 자동 입장문자 (NCP SENS — bulsaja 계정 공유, 실값은 .env.local/Vercel env)
NCP_SENS_ACCESS=
NCP_SENS_SECRET=
NCP_SENS_ID=
NCP_SENS_NUMBER=
