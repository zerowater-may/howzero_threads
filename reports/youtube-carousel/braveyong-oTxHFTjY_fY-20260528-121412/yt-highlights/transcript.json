  {
    "t": 212.12,
    "d": 4.399,
    "text": ">> 네. 네. 애들이 이제 학교도 보내고"
  },
  {
    "t": 213.879,
    "d": 3.881,
    "text": "유치원 보냈으니까 이제 일해야죠."
  },
  {
    "t": 216.519,
    "d": 4.161,
    "text": "가야 됩니다. 건너가실까요?"
  },
  {
    "t": 217.76,
    "d": 5.8,
    "text": ">> 네. 제가 듣기로는 부동산 투자에도"
  },
  {
    "t": 220.68,
    "d": 4.559,
    "text": "좀 일가이 있으시다고 들었어요. 원래"
  },
  {
    "t": 223.56,
    "d": 3.8,
    "text": "부업으로 공부를 했었던게"
  },
  {
    "t": 225.239,
    "d": 3.72,
    "text": "부동산이었거든요. 제가 부동산을"
