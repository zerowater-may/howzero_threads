  {
    "t": 187.36,
    "d": 4.08,
    "text": "그렇게 쉽게 돈 버는 건 아니고 자기"
  },
  {
    "t": 189.2,
    "d": 3.92,
    "text": "노력이 충분히 들어가야 되는게"
  },
  {
    "t": 191.44,
    "d": 4.0,
    "text": "맞아요. 어, 저는 항상 그"
  },
  {
    "t": 193.12,
    "d": 4.16,
    "text": "시스템화하는데 관심이 많아서 지금"
  },
  {
    "t": 195.44,
    "d": 3.6,
    "text": "하고 있는 것도 최대한 어떻게 하면"
  },
  {
    "t": 197.28,
    "d": 3.64,
    "text": "더 줄일 수 있을까, 자동화 할 수"
  },
  {
    "t": 199.04,
    "d": 3.64,
    "text": "있을까 이런 거를 항상 고민하면서"
  },
  {
    "t": 200.92,
    "d": 4.2,
    "text": "일을 하고 있어요. 피드 님, 그러면"
  },
  {
    "t": 202.68,
    "d": 3.6,
    "text": "저 이제 집에 가서 둘째 좀 케어하고"
  },
  {
    "t": 205.12,
    "d": 2.56,
    "text": "보내고 다시 오겠습니다."
  },
  {
    "t": 206.28,
    "d": 2.039,
    "text": ">> 아, 네. 알겠습니다. 대표님"
  },
  {
    "t": 207.68,
    "d": 2.16,
    "text": "기다릴게요."
