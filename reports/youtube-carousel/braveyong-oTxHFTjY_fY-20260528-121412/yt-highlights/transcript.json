[
  {
    "t": 0.08,
    "d": 3.48,
    "text": "다들 공감하실 거예요. 직장님"
  },
  {
    "t": 1.52,
    "d": 4.0,
    "text": "월급으로 충분히 노후 대비라든가"
  },
  {
    "t": 3.56,
    "d": 4.319,
    "text": "이런게 될 수가 없어요. 어떻게 하면"
  },
  {
    "t": 5.52,
    "d": 3.84,
    "text": "내가 큰 돈을 들이지 않고 헌금흐름이"
  },
  {
    "t": 7.879,
    "d": 4.121,
    "text": "만들어지는 그런 일을 할 수"
  },
  {
    "t": 9.36,
    "d": 7.2,
    "text": "있을까라고 생각을 하다가게 된게 이런"
  },
  {
    "t": 12.0,
    "d": 6.56,
    "text": "온라인 셀링 분야. 이거는 그 부동산"
  },
  {
    "t": 16.56,
    "d": 3.52,
    "text": "작은 부동산들 그냥 등기만 이렇게"
  },
  {
    "t": 18.56,
    "d": 3.12,
    "text": "모아 놓은 거예요. 영매한 것도 있고"
  },
  {
    "t": 20.08,
    "d": 3.32,
    "text": "일반 매매한 것도 있고 뭐 이런"
  },
  {
    "t": 21.68,
    "d": 4.04,
    "text": "식으로 많으신데"
  },
  {
    "t": 23.4,
    "d": 4.639,
    "text": ">> 제가 원하는 키워드들로 하나 둘 셋네"
  },
  {
    "t": 25.72,
    "d": 4.319,
    "text": "개 키워드들로 뭐로 검색해도 지금"
  },
  {
    "t": 28.039,
    "d": 3.72,
    "text": "네이버 1위가 왔다 갔다 해요."
  },
  {
    "t": 30.039,
    "d": 3.961,
    "text": "여기는 4위가 됐다 6위 됐다가"
  },
  {
    "t": 31.759,
    "d": 4.041,
    "text": "지금도 1위죠.이 키워드는 계속이"
  },
  {
    "t": 34.0,
    "d": 4.32,
    "text": "1이 이게 한 네다섯 달 전에"
  },
  {
    "t": 35.8,
    "d": 4.8,
    "text": "작업했던 거거든요."
  },
  {
    "t": 38.32,
    "d": 3.88,
    "text": "11개 키워드로 검색을 했을 때"
  },
  {
    "t": 40.6,
    "d": 3.6,
    "text": "네이버 1페이지 노출되는 거죠."
  },
  {
    "t": 42.2,
    "d": 3.48,
    "text": "이거도 두 달 정도 전에 딱 한 번"
  },
  {
    "t": 44.2,
    "d": 3.44,
    "text": "작업해 놓은 거예요. 그다음부터는"
  },
  {
    "t": 45.68,
    "d": 4.16,
    "text": "건드릴게 없어요. 그냥 가만히 놔두면"
  },
  {
    "t": 47.64,
    "d": 4.079,
    "text": "이제 자연적으로 점점점 상위 노출이"
