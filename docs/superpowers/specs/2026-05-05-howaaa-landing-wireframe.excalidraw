    {"type":"text","id":"sec7h","x":280,"y":2940,"width":560,"height":32,"text":"AI 팀에는 6명의 담당자가 있습니다","fontSize":22,"fontFamily":3,"strokeColor":"#ffffff","roughness":0,"seed":17003,"textAlign":"center"},
    {"type":"text","id":"sec7sub","x":280,"y":2976,"width":560,"height":20,"text":"각자 역할이 있고, 카드 한 장이 차례로 거쳐갑니다.","fontSize":12,"fontFamily":3,"strokeColor":"#d8dee6","roughness":0,"seed":17004,"textAlign":"center"},

