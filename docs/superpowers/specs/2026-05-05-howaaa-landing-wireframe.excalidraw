    {"type":"text","id":"note4","x":980,"y":1740,"width":420,"height":80,"text":"WHY  ai-team Point 02 차용. 짝수 step만\n다크 채움 → 시선 리듬. '사람 결정' Gate가\n검증 단계 1곳뿐임을 시각으로 강조.","fontSize":12,"fontFamily":3,"strokeColor":"#555555","roughness":0,"seed":14099},

    {"type":"text","id":"lbl5","x":60,"y":1980,"width":140,"height":24,"text":"§5 POINT 03\n운영 자산화","fontSize":16,"fontFamily":3,"strokeColor":"#1e1e1e","roughness":0,"seed":15001},
    {"type":"rectangle","id":"sec5","x":200,"y":1960,"width":720,"height":380,"backgroundColor":"#fafafa","fillStyle":"solid","strokeColor":"#cfd5db","strokeWidth":1,"roundness":{"type":3},"roughness":0,"seed":15002},
