    {"type":"text","id":"sec5pilltxt","x":538,"y":1995,"width":44,"height":14,"text":"POINT 03","fontSize":10,"fontFamily":3,"strokeColor":"#ffffff","roughness":0,"seed":15004},
    {"type":"text","id":"sec5h","x":260,"y":2024,"width":600,"height":32,"text":"운영 카드가 사라지지 않고 자산이 됩니다","fontSize":22,"fontFamily":3,"strokeColor":"#1e1e1e","roughness":0,"seed":15005,"textAlign":"center"},
    {"type":"text","id":"sec5sub","x":280,"y":2060,"width":560,"height":40,"text":"AI가 다음 카드를 만들 때, 지난 카드의 성과·결정이\n그대로 컨텍스트로 들어갑니다. 인수인계가 사라집니다.","fontSize":12,"fontFamily":3,"strokeColor":"#5a636a","roughness":0,"seed":15006,"textAlign":"center"},

    {"type":"rectangle","id":"sec5img1","x":260,"y":2140,"width":300,"height":160,"backgroundColor":"#e5e5e5","fillStyle":"hachure","strokeColor":"#cfd5db","strokeWidth":1,"roundness":{"type":3},"roughness":0,"seed":15010},
    {"type":"text","id":"sec5img1t","x":280,"y":2210,"width":260,"height":20,"text":"[ 사진: 노트북으로 카드 검토 ]","fontSize":12,"fontFamily":3,"strokeColor":"#555555","roughness":0,"seed":15011,"textAlign":"center"},
    {"type":"rectangle","id":"sec5img2","x":580,"y":2140,"width":300,"height":160,"backgroundColor":"#e5e5e5","fillStyle":"hachure","strokeColor":"#cfd5db","strokeWidth":1,"roundness":{"type":3},"roughness":0,"seed":15012},
    {"type":"text","id":"sec5img2t","x":600,"y":2210,"width":260,"height":20,"text":"[ 사진: 화이트보드 미팅 ]","fontSize":12,"fontFamily":3,"strokeColor":"#555555","roughness":0,"seed":15013,"textAlign":"center"},
    {"type":"text","id":"sec5cap","x":280,"y":2310,"width":560,"height":18,"text":"\"월 80개 카드 운영 · 인수인계 0회\" 같은 한 줄 metric (옵션)","fontSize":11,"fontFamily":3,"strokeColor":"#757575","roughness":0,"seed":15014,"textAlign":"center"},
    {"type":"text","id":"note5","x":980,"y":2150,"width":420,"height":80,"text":"WHY  ai-team Point 03 차용 (사람 두 컷).\n'인수인계 0회'가 OS의 진짜 가치 → 한 줄로\nproof 박기.","fontSize":12,"fontFamily":3,"strokeColor":"#555555","roughness":0,"seed":15099},

    {"type":"text","id":"lbl6","x":60,"y":2400,"width":140,"height":24,"text":"§6 DARK\n임팩트 중심","fontSize":16,"fontFamily":3,"strokeColor":"#1e1e1e","roughness":0,"seed":16001},
    {"type":"rectangle","id":"sec6","x":200,"y":2380,"width":720,"height":480,"backgroundColor":"#0b1018","fillStyle":"solid","strokeColor":"#0b1018","strokeWidth":2,"roundness":{"type":3},"roughness":0,"seed":16002},
    {"type":"text","id":"sec6h","x":230,"y":2430,"width":340,"height":80,"text":"AI 팀의 OS는,\n비즈니스 임팩트가 중심입니다.","fontSize":22,"fontFamily":3,"strokeColor":"#ffffff","roughness":0,"seed":16003},
    {"type":"text","id":"sec6p","x":230,"y":2540,"width":340,"height":80,"text":"콘텐츠는 단순히 발행하는 것이 아닙니다.\n매출 증대와 비용 절감으로 연결되는 카드만\n우선 순위에 올라옵니다.","fontSize":12,"fontFamily":3,"strokeColor":"#d8dee6","roughness":0,"seed":16004},

    {"type":"rectangle","id":"sec6c1","x":600,"y":2420,"width":300,"height":120,"backgroundColor":"#10171f","fillStyle":"solid","strokeColor":"#1a2330","strokeWidth":1,"roundness":{"type":3},"roughness":0,"seed":16010},
    {"type":"text","id":"sec6c1t","x":620,"y":2510,"width":260,"height":18,"text":"트렌드 적합도 (거품 차트)","fontSize":12,"fontFamily":3,"strokeColor":"#d8dee6","roughness":0,"seed":16011},
