    {"type":"text","id":"sec3sub","x":280,"y":1100,"width":560,"height":40,"text":"유튜브, 인스타, 검색, 뉴스, 자사 데이터까지.\nHOWAAA가 매일 아침 콘텐츠 카드 위에 올려둡니다.","fontSize":12,"fontFamily":3,"strokeColor":"#5a636a","roughness":0,"seed":13006,"textAlign":"center"},

