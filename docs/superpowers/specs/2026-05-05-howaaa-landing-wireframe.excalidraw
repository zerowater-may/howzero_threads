    {"type":"rectangle","id":"sec1pill","x":500,"y":260,"width":120,"height":24,"backgroundColor":"transparent","fillStyle":"solid","strokeColor":"#e5e5e5","strokeWidth":1,"roundness":{"type":3},"roughness":0,"seed":11010},
    {"type":"text","id":"sec1pilltxt","x":510,"y":265,"width":100,"height":16,"text":"COLLABORATIVE AI OS","fontSize":10,"fontFamily":3,"strokeColor":"#e5e5e5","roughness":0,"seed":11011},
    {"type":"text","id":"sec1h1","x":260,"y":300,"width":600,"height":80,"text":"콘텐츠 한 편을, AI 팀이\n끝까지 운영합니다.","fontSize":40,"fontFamily":3,"strokeColor":"#ffffff","roughness":0,"seed":11012,"textAlign":"center"},
    {"type":"text","id":"sec1sub","x":280,"y":420,"width":560,"height":40,"text":"트렌드 수집부터 발행과 성과 회수까지.\n카드 하나가 AI 팀에 자동 배정됩니다.","fontSize":14,"fontFamily":3,"strokeColor":"#d8dee6","roughness":0,"seed":11013,"textAlign":"center"},
    {"type":"rectangle","id":"sec1cta1","x":420,"y":510,"width":140,"height":44,"backgroundColor":"#4a9eed","fillStyle":"solid","strokeColor":"#4a9eed","strokeWidth":1,"roundness":{"type":3},"roughness":0,"seed":11014},
