    {"type":"text","id":"sec9gradh","x":280,"y":3950,"width":560,"height":50,"text":"어디서부터 시작할지 모르겠다면\n14일 무료 체험으로 첫 카드부터 띄워보세요.","fontSize":18,"fontFamily":3,"strokeColor":"#ffffff","roughness":0,"seed":19005,"textAlign":"center"},
