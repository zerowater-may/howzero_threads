    {"type":"text","id":"sec6c3t","x":620,"y":2790,"width":260,"height":18,"text":"자동화 매핑 (node-link)","fontSize":12,"fontFamily":3,"strokeColor":"#d8dee6","roughness":0,"seed":16015},
    {"type":"text","id":"note6","x":980,"y":2580,"width":420,"height":80,"text":"WHY  ai-team의 다크 + 라인아트 그래프 패턴.\n좌 텍스트 / 우 카드 3장으로 '비즈니스 OS임'\n을 시각으로 차별화.","fontSize":12,"fontFamily":3,"strokeColor":"#555555","roughness":0,"seed":16099},

