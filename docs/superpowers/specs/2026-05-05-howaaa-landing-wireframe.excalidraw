    {"type":"rectangle","id":"sec1cta2","x":580,"y":510,"width":140,"height":44,"backgroundColor":"transparent","fillStyle":"solid","strokeColor":"#e5e5e5","strokeWidth":1,"roundness":{"type":3},"roughness":0,"seed":11016},
    {"type":"text","id":"sec1cta2txt","x":605,"y":523,"width":90,"height":18,"text":"도입 상담 받기","fontSize":13,"fontFamily":3,"strokeColor":"#e5e5e5","roughness":0,"seed":11017},
    {"type":"text","id":"note1","x":980,"y":350,"width":420,"height":80,"text":"WHY  추상적 'AI 회사' 톤을 깨고\n사람이 일하는 현장으로 구체화.\nDark BG + 한 줄 메시지로 임팩트 우선.","fontSize":12,"fontFamily":3,"strokeColor":"#555555","roughness":0,"seed":11099},

    {"type":"text","id":"lbl2","x":60,"y":680,"width":140,"height":24,"text":"§2 PROBLEM\nLight","fontSize":16,"fontFamily":3,"strokeColor":"#1e1e1e","roughness":0,"seed":12001},
    {"type":"rectangle","id":"sec2","x":200,"y":660,"width":720,"height":280,"backgroundColor":"#ffffff","fillStyle":"solid","strokeColor":"#cfd5db","strokeWidth":1,"roundness":{"type":3},"roughness":0,"seed":12002},
    {"type":"line","id":"sec2div1","x":380,"y":750,"width":360,"height":0,"points":[[0,0],[360,0]],"strokeColor":"#cfd5db","strokeWidth":1,"roughness":0,"seed":12003},
    {"type":"text","id":"sec2h","x":280,"y":770,"width":560,"height":40,"text":"똑같은 AI 도구를 써도, 결과는 모두 다릅니다.","fontSize":24,"fontFamily":3,"strokeColor":"#1e1e1e","roughness":0,"seed":12004,"textAlign":"center"},
    {"type":"text","id":"sec2p","x":280,"y":820,"width":560,"height":60,"text":"AI는 콘텐츠 한 편을 빠르게 만들 수 있습니다.\n하지만 트렌드 추적, 분배, 검증, 발행, 회수까지 운영하는 일은\n여전히 사람이 들고 있습니다.","fontSize":13,"fontFamily":3,"strokeColor":"#5a636a","roughness":0,"seed":12005,"textAlign":"center"},
    {"type":"line","id":"sec2div2","x":380,"y":900,"width":360,"height":0,"points":[[0,0],[360,0]],"strokeColor":"#cfd5db","strokeWidth":1,"roughness":0,"seed":12006},
    {"type":"text","id":"note2","x":980,"y":770,"width":420,"height":60,"text":"WHY  본격 메시지 진입 전 '문제 동의'.\n짧고 센터 정렬 → 호흡 + 다음 섹션 흡인.","fontSize":12,"fontFamily":3,"strokeColor":"#555555","roughness":0,"seed":12099},

    {"type":"text","id":"lbl3","x":60,"y":1020,"width":140,"height":24,"text":"§3 POINT 01\n트렌드 자동","fontSize":16,"fontFamily":3,"strokeColor":"#1e1e1e","roughness":0,"seed":13001},
